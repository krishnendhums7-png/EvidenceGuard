# ==============================================================================
# EvidenceGuard Environment Configuration Template
# Copy this file to .env and configure your specific local settings.
# ==============================================================================

# Gemini API Configuration (Leave blank if only verifying user-pasted LLM responses)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-2.5-flash

# Embeddings & Vector Retrieval Settings
# Recommended local CPU models:
# - all-MiniLM-L6-v2 (fast, lightweight ~80MB, 384 dimensions)
# - BAAI/bge-small-en-v1.5 (compact ~130MB, 384 dimensions)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
RETRIEVAL_TOP_K=5
RETRIEVAL_SIMILARITY_THRESHOLD=0.30

# NLI Verification Model Settings
# Recommended DeBERTa-based NLI models:
# - cross-encoder/nli-deberta-v3-small (robust 3-way classification, ~140MB)
# - MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli (FEVER fine-tuned, ~500MB)
NLI_MODEL_NAME=cross-encoder/nli-deberta-v3-small
NLI_NEI_THRESHOLD=0.50

# Application Paths (Optional overrides, defaults relative to project root)
# DATA_DIR=data
# INDEX_DIR=indexes
# LOG_DIR=logs
# RESULTS_DIR=results

# Logging & Environment
LOG_LEVEL=INFO
ENVIRONMENT=development
